{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "duda-salvados",
  "main": "src/index.js",
  "compatibility_date": "2026-08-11",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
